function torque_lookup(rpm) {
	// https://docs.scipy.org/doc/scipy/tutorial/interpolate/smoothing_splines.html
	var torque_table = [
		407.91299887, 404.86590237, 402.21892535, 399.96433231,
		398.09438779, 396.60135631, 395.47750239, 394.71509057,
		394.30638535, 394.24365127, 394.51915286, 395.12515463,
		396.05392112, 397.29771684, 398.84880632, 400.69945408,
		402.84192465, 405.26848256, 407.97139233, 410.94291847,
		414.17532553, 417.66087801, 421.39184045, 425.36047738,
		429.5590533 , 433.97983276, 438.61508027, 443.45706035,
		448.49803755, 453.72269348, 459.0853783 , 464.53285923,
		470.01190354, 475.46927847, 480.85175127, 486.10608918,
		491.17905946, 496.01742935, 500.5679661 , 504.77743696,
		508.59260917, 511.96025   , 514.82712667, 517.15442721,
		518.96102261, 520.28020467, 521.14526515, 521.58949583,
		521.64618848, 521.34863488, 520.73012679, 519.823956  ,
		518.66341428, 517.28179339, 515.71238512, 513.98848124,
		512.13893915, 510.17487874, 508.10298554, 505.92994507,
		503.66244286, 501.30716443, 498.87079529, 496.36002098,
		493.78152702, 491.14199893, 488.44812223, 485.70658245,
		482.92406511, 480.10725573, 477.26283983, 474.39750295,
		471.51793059, 468.6308083 , 465.74282158, 462.86065596,
		459.99099697, 457.14053012, 454.31594094, 451.52391496,
		448.7711377 , 446.06429467, 443.41007141, 440.80271606,
		438.18672725, 435.49416627, 432.65709438, 429.60757283,
		426.27766291, 422.59942587, 418.50492298, 413.92621551,
		408.79536472, 403.04443189, 396.60547827, 389.41056514,
		381.39175376, 372.52802967, 362.98607554, 352.97949833,
		342.72190497, 332.45847683, 322.56069298, 313.4316069 ,
		305.48184246, 299.15230493, 294.89147   , 293.14781331,
		294.36981053, 299.00593732
	];
	var index = max(1, min(array_length(torque_table)-2, rpm div 100));
	var lerp_value = (rpm - (rpm div 100)) / 100;
	return lerp(torque_table[index-1], torque_table[index], lerp_value);
}