function torque_lookup(rpm) {
	// https://docs.scipy.org/doc/scipy/tutorial/interpolate/smoothing_splines.html
	var torque_table = [
399.86, 394.32, 390.95, 389.57,
390.00, 392.06, 395.58, 400.39,
406.29, 413.12, 420.69, 428.83,
437.37, 446.12, 454.91, 463.56,
471.90, 479.73, 486.90, 493.21,
498.50, 502.64, 505.74, 507.94,
509.42, 510.33, 510.82, 511.07,
511.21, 511.42, 511.86, 512.63,
513.67, 514.87, 516.13, 517.33,
518.37, 519.14, 519.52, 519.41,
518.70, 517.31, 515.32, 512.83,
509.94, 506.75, 503.37, 499.91,
496.46, 493.14, 490.04, 487.24,
484.74, 482.50, 480.48, 478.64,
476.95, 475.38, 473.89, 472.44,
470.99, 469.51, 467.97, 466.33,
464.56, 462.61, 460.45, 458.04,
455.36, 452.36, 449.01, 445.29,
441.21, 436.82, 432.16, 427.25,
422.14, 416.86, 411.46, 405.96,
400.41, 394.84, 389.28, 383.79,
378.38, 373.10, 367.99, 363.08,
358.41, 354.02, 349.94, 346.21,
342.86, 339.95, 337.49, 335.53,
334.10, 333.25, 333.00, 333.40,
	];
	var index = max(1, min(array_length(torque_table)-2, rpm div 100));
	var lerp_value = (rpm - (rpm div 100)) / 100;
	return lerp(torque_table[index-1], torque_table[index], lerp_value);
}