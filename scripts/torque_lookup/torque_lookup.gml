function torque_lookup(rpm) {
	// https://docs.scipy.org/doc/scipy/tutorial/interpolate/smoothing_splines.html
	var torque_table = [
599.84, 594.41, 591.12, 589.80,
590.26, 592.34, 595.85, 600.63,
606.50, 613.28, 620.81, 628.90,
637.37, 646.07, 654.81, 663.41,
671.70, 679.51, 686.67, 692.99,
698.30, 702.49, 705.64, 707.92,
709.47, 710.45, 711.00, 711.28,
711.43, 711.62, 712.00, 712.66,
713.57, 714.63, 715.75, 716.84,
717.80, 718.55, 719.00, 719.04,
718.60, 717.60, 716.07, 714.05,
711.60, 708.76, 705.58, 702.11,
698.40, 694.49, 690.44, 686.29,
682.07, 677.82, 673.59, 669.39,
665.27, 661.26, 657.40, 653.73,
650.27, 647.04, 644.01, 641.11,
638.28, 635.47, 632.62, 629.66,
626.54, 623.20, 619.58, 615.63,
611.37, 606.84, 602.07, 597.09,
591.93, 586.63, 581.23, 575.75,
570.22, 564.69, 559.18, 553.73,
548.37, 543.13, 538.05, 533.16,
528.49, 524.08, 519.95, 516.15,
512.71, 509.65, 507.01, 504.83,
503.14, 501.97, 501.35, 501.32,
	];
	var index = max(1, min(array_length(torque_table)-2, rpm div 100));
	var lerp_value = (rpm - (rpm div 100)) / 100;
	return lerp(torque_table[index-1], torque_table[index], lerp_value);
}